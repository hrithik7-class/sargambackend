# ─────────────────────────────────────────────
# SargamAI Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────

# JWT — generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sargamdb

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
# Create an app at https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Frontend URL (used for OAuth redirect URIs and CORS)
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# Server
# For local dev: set DEBUG=true to skip email verification when SMTP is not configured
DEBUG=false

# ─────────────────────────────────────────────
# AI Services — Core Generation Feature
# ─────────────────────────────────────────────

# Groq API — free lyrics generation (Llama 3.3-70B, 1000 req/day free)
# Sign up at https://console.groq.com/keys
GROQ_API_KEY=
# Override model if desired (e.g. qwen3-32b for better Hindi)
GROQ_MODEL=llama-3.3-70b-versatile

# Replicate — AI music synthesis (MiniMax Music 2.5, free trial credits)
# Sign up at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Genius API — copyright/lyrics similarity check (free)
# Register your app at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# SMTP for email verification (OTP)
# Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sargamai.com

# Local directory where generated audio files are stored
MEDIA_DIR=media/tracks

# ─────────────────────────────────────────────
# Payments — Lemon Squeezy + Razorpay
# ─────────────────────────────────────────────

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
# Create API key and webhook; get Store ID and Variant IDs from dashboard
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_PRO=
LEMON_SQUEEZY_VARIANT_STUDIO=

# Razorpay — https://dashboard.razorpay.com/app/keys
# Create Standard account; get Key ID + Secret; set webhook in Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Amounts in paise (e.g. 1200 = 12 INR for Pro)
RAZORPAY_PLAN_PRO_AMOUNT=1200
RAZORPAY_PLAN_STUDIO_AMOUNT=2900
RAZORPAY_CURRENCY=INR
